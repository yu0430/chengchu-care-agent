  "brand_principles": [
    {
      "id": "B01",
      "title": "品牌主张",
      "source_text": "用清晰、克制的产品信息，帮助顾客做适合自己的日常护理选择。",
      "source": {
        "document": "08题 澄初个人护理.pdf",
        "page": 1,
        "section": "一、品牌定位",
        "locator": "品牌主张"
      }
    },
    {
      "id": "B02",
      "title": "服务原则",
      "source_text": "先了解需求，再提出选择；不制造焦虑，不夸大效果，不强推连带购买。",
      "source": {
        "document": "08题 澄初个人护理.pdf",
        "page": 1,
        "section": "一、品牌定位",
        "locator": "服务原则"
      }
    },
    {
      "id": "B03",
      "title": "沟通语气",
      "source_text": "温和、具体、尊重顾客决定。使用“可以考虑”“如果您在意……”等表达。",
      "source": {
        "document": "08题 澄初个人护理.pdf",
        "page": 1,
        "section": "一、品牌定位",
        "locator": "沟通语气"
      }
    },
    {
      "id": "B04",
      "title": "不可承诺",
      "source_text": "不说“治愈、治疗、保证有效、绝对不过敏、马上见效”；不对价格、赠品、退换或授权作无依据承诺。",
      "source": {
        "document": "08题 澄初个人护理.pdf",
        "page": 1,
        "section": "一、品牌定位",
        "locator": "不可承诺"
      }
    },
    {
      "id": "B05",
      "title": "安全边界",
      "source_text": "不作医疗诊断。顾客提到明显不适、受损或持续问题时，建议停止刺激性尝试并咨询专业人士。",
      "source": {
        "document": "08题 澄初个人护理.pdf",
        "page": 1,
        "section": "一、品牌定位",
        "locator": "安全边界"
